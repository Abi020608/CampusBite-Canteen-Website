        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\ndirection TB\n\nclass MenuItem {\n  -Long id\n  -String name\n  -String description\n  -BigDecimal price\n  -Integer stock\n  -String category\n  +getId() Long\n  +getName() String\n  +getPrice() BigDecimal\n  +getStock() Integer\n  +setStock(Integer stock) void\n}\n\nclass CanteenOrder {\n  -Long id\n  -String customerName\n  -BigDecimal totalAmount\n  -LocalDateTime createdAt\n  -String status\n  -List~OrderLine~ orderLines\n  +getTotalAmount() BigDecimal\n  +setTotalAmount(BigDecimal amount) void\n  +getStatus() String\n  +setStatus(String status) void\n}\n\nclass OrderLine {\n  -Long id\n  -CanteenOrder order\n  -MenuItem menuItem\n  -Integer quantity\n  -BigDecimal unitPrice\n  -BigDecimal subtotal\n  +calculateSubtotal() BigDecimal\n  +getQuantity() Integer\n  +getSubtotal() BigDecimal\n}\n\nclass OrderRequest {\n  -String customerName\n  -List~OrderItemRequest~ items\n  +getCustomerName() String\n  +getItems() List\n}\n\nclass OrderItemRequest {\n  -Long menuItemId\n  -Integer quantity\n  +getMenuItemId() Long\n  +getQuantity() Integer\n}\n\nclass MenuItemRepository {\n  +findAll() List~MenuItem~\n  +findById(Long id) Optional\n  +save(MenuItem item) MenuItem\n  +deleteById(Long id) void\n}\n\nclass CanteenOrderRepository {\n  +findAll() List~CanteenOrder~\n  +findById(Long id) Optional\n  +save(CanteenOrder order) CanteenOrder\n}\n\nclass OrderService {\n  -MenuItemRepository menuItemRepository\n  -CanteenOrderRepository orderRepository\n  +placeOrder(OrderRequest request) CanteenOrder\n  +checkStock(Long itemId, Integer quantity) boolean\n  +updateStock(Long itemId, Integer quantity) void\n  +getAllOrders() List~CanteenOrder~\n  +getDashboardData() Map\n}\n\nclass ApiController {\n  -OrderService orderService\n  +getMenu() List~MenuItem~\n  +placeOrder(OrderRequest request) CanteenOrder\n  +getOrders() List~CanteenOrder~\n  +getDashboard() Map\n  +addMenuItem(MenuItem item) MenuItem\n  +updateStock(Long id, Integer stock) MenuItem\n}\n\nclass ApiExceptionHandler {\n  +handleException(Exception ex) ResponseEntity\n  +handleValidationError(Exception ex) ResponseEntity\n}\n\nclass CanteenApplication {\n  +main(String[] args) void\n}\n\nCanteenOrder \&quot;1\&quot; *-- \&quot;1..*\&quot; OrderLine : contains\nMenuItem \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; OrderLine : selected item\nOrderRequest \&quot;1\&quot; *-- \&quot;1..*\&quot; OrderItemRequest : contains\n\nMenuItemRepository ..&gt; MenuItem : manages\nCanteenOrderRepository ..&gt; CanteenOrder : manages\n\nApiController --&gt; OrderService : uses\nOrderService --&gt; MenuItemRepository : uses\nOrderService --&gt; CanteenOrderRepository : uses\nOrderService ..&gt; OrderRequest : processes\nApiExceptionHandler ..&gt; ApiController : handles errors\nCanteenApplication ..&gt; ApiController : starts application\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="1vmGwx-Np5AJtq2s75Tw-139">
